# PostgreSQL — must be a NON-superuser role so row-level security is enforced.
DATABASE_URL=postgresql://hrm:hrm@localhost:5432/hrm?schema=public
TEST_DATABASE_URL=postgresql://hrm:hrm@localhost:5432/hrm_test?schema=public
PORT=4000
HOST=0.0.0.0
# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# 32 random bytes, base64 — e.g. `openssl rand -base64 32`
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
