# PostgreSQL — must be a NON-superuser role so row-level security is enforced.
DATABASE_URL=postgresql://hrm:hrm@localhost:5432/hrm?schema=public
TEST_DATABASE_URL=postgresql://hrm:hrm@localhost:5432/hrm_test?schema=public
# Playwright API server database (must end in _e2e; wiped and re-seeded on every `pnpm e2e`)
E2E_DATABASE_URL=postgresql://hrm:hrm@localhost:5432/hrm_e2e?schema=public
# Port of the embedded PostgreSQL started by `pnpm db:start` (default 5432)
LOCAL_PG_PORT=5432
PORT=4000
HOST=0.0.0.0
# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# 32 random bytes, base64 — e.g. `openssl rand -base64 32`
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
# Reverse proxy trust for client IPs (rate limiting, audit): false (default, direct exposure),
# true (trust all hops), a hop count such as 1, or a comma-separated list of proxy IPs/CIDRs.
TRUST_PROXY=false
# Global API requests per minute per IP
RATE_LIMIT_MAX=300
# File storage (local disk driver; relative to hrm-api/) and upload limit in bytes (10 MB)
FILE_STORAGE_DIR=uploads
FILE_MAX_BYTES=10485760
# OpenAPI JSON at /docs/json + Swagger UI at /docs (default: on unless NODE_ENV=production)
# API_DOCS=true
# Push notifications sent by the worker (`pnpm --filter @hrm/api worker`): none (deliveries SKIPPED) | expo
PUSH_PROVIDER=none
# Optional Expo access token when push security is enabled for the Expo project
EXPO_ACCESS_TOKEN=
# Push/SMS delivery attempts before a delivery is marked FAILED
DELIVERY_MAX_ATTEMPTS=5

# First-login SMS phone verification (FR-AUTH-02.1). Ignored (off) in production until a real SMS gateway is configured.
REQUIRE_PHONE_VERIFICATION=true
