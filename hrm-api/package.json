{
  "name": "@hrm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "prisma generate && tsup",
    "lint": "eslint src test prisma scripts",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "db:start": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@fastify/cors": "~11.4.0",
    "@fastify/helmet": "~13.2.0",
    "@fastify/jwt": "~9.1.0",
    "@fastify/rate-limit": "~10.3.0",
    "@hrm/shared": "workspace:*",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "~3.0.0",
    "fastify": "~5.6.0",
    "fastify-plugin": "~5.1.0",
    "fastify-type-provider-zod": "~4.0.2",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@types/node": "~22.20.0",
    "prisma": "~6.19.0",
    "tsup": "~8.5.0",
    "tsx": "~4.20.0",
    "vitest": "~3.2.0",
    "embedded-postgres": "16.15.0-beta.19"
  }
}
