// SOM HRM — Phase 1 data model.
// Every tenant table carries `workspaceId` and is protected by PostgreSQL
// row-level security (see migrations/*_rls). Enum values mirror packages/shared/src/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentStatus {
  PROBATION
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

/// FR-EMP-03.5 — kind of employment contract (replaces the contract half of the old EmploymentType).
enum ContractType {
  INDEFINITE
  FIXED_TERM
  PROBATION
}

/// FR-EMP-03.6 — how pay is calculated (replaces the pay half of the old EmploymentType).
enum PayType {
  MONTHLY
  DAILY
  HOURLY
}

enum NationalityType {
  LAO
  FOREIGN
}

enum DocumentType {
  WORK_PERMIT
  VISA
  PASSPORT
  RESIDENCE_PERMIT
  ID_CARD
  FAMILY_BOOK
  CONTRACT
  MEDICAL_CERT
  OTHER
}

/// Result of one employee's work date (AttendanceDay, FR-ATT-18). Late + early leave on the same day
/// is LATE; the minute columns keep both.
enum AttendanceStatus {
  PRESENT
  LATE
  EARLY
  ABSENT
  MISSING_IN
  MISSING_OUT
  HOLIDAY
  REST
  LEAVE
}

/// How a punch reached the system (A13).
enum AttendanceSource {
  MOBILE
  KIOSK
  SCANNER
  HR_ON_BEHALF
  CORRECTION
}

enum PunchKind {
  IN
  OUT
}

/// Review of a suspicious or off-site punch (FR-ATT-14, FR-ATT-16.3). NONE = nothing to review.
enum PunchReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/// Ways a branch records attendance; several can be enabled at once (FR-WS-06).
enum AttendanceMode {
  MOBILE
  SCANNER
  KIOSK
}

/// FR-ATT-20.1/20.2 — requested before the work (PRE) or after it (POST).
enum OvertimeKind {
  PRE
  POST
}

/// Scanner export layouts (FR-ATT-02.1–02.3).
enum ScanFormat {
  ZKTECO
  HIP
  GENERIC
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveCategory {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  PERSONAL
  MARRIAGE
  BEREAVEMENT
  UNPAID
  /// HR-defined custom type (FR-LV-02), e.g. ordination or exam leave; no legal minimum.
  OTHER
}

enum HalfDay {
  NONE
  AM
  PM
}

enum ScanImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Outcome of one scanner row at preview/confirm (FR-ATT-02.4/02.5).
enum ScanRowStatus {
  OK
  UNMATCHED
  DUPLICATE
  INVALID
}

enum TaskKind {
  ONBOARDING
  OFFBOARDING
}

enum NotificationType {
  DOCUMENT_EXPIRY
  LEAVE_REQUEST
  LEAVE_DECISION
  CORRECTION_REQUEST
  CORRECTION_DECISION
  SUSPICIOUS_ATTENDANCE
  SYSTEM
  APPROVAL_PENDING
  APPROVAL_DECISION
  APPROVAL_ESCALATED
  MISSING_PUNCH
  PROBATION_ENDING
  OFFLINE_UNSYNCED
  /// A medical certificate is still missing and due soon / overdue (FR-LV-05.3).
  LEAVE_CERTIFICATE_DUE
}

enum NotificationChannel {
  PUSH
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  FIRST_LOGIN
  PASSWORD_RESET
}

enum FilePurpose {
  EMPLOYEE_DOCUMENT
  SELFIE
  ATTACHMENT
  IMPORT
}

enum Platform {
  IOS
  ANDROID
  WEB
}

// ─────────────────────── Tenant & billing ───────────────────────

model Workspace {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  timezone  String          @default("Asia/Vientiane")
  locale    String          @default("lo")
  status    WorkspaceStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  subscription Subscription?
  users        User[]
  roles        Role[]
  employees    Employee[]
  branches     Branch[]
  departments  Department[]
  positions    Position[]
}

model Subscription {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  plan        String    @default("trial")
  seatLimit   Int       @default(50)
  seatCredit  Int       @default(0)
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ──────────────────────── Identity & RBAC ────────────────────────

model User {
  id                   String    @id @default(cuid())
  workspaceId          String
  employeeId           String?   @unique
  email                String?
  phone                String?
  displayName          String
  passwordHash         String?
  pinHash              String?
  mustChangeCredential Boolean   @default(false)
  /// Set once the phone number has been confirmed with an SMS OTP (FR-AUTH-02.1).
  phoneVerifiedAt      DateTime?
  isActive             Boolean   @default(true)
  failedAttempts       Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  locale               String    @default("lo")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee      Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  devices       DeviceBinding[]
  notifications Notification[]
  pushTokens    PushToken[]

  @@unique([workspaceId, email])
  @@unique([workspaceId, phone])
  @@index([workspaceId])
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  code        String
  name        String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([workspaceId, code])
}

/// Global catalogue of permission keys (not tenant scoped).
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  workspaceId  String
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([workspaceId])
}

model UserRole {
  workspaceId String
  userId      String
  roleId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([workspaceId])
}

model RefreshToken {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  /// All tokens rotated from one sign-in share a family; re-use revokes only that family.
  familyId    String
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([familyId])
}

/// Append-only (UPDATE/DELETE blocked by trigger, see migration *_m2_foundation).
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entity, entityId])
}

/// The phone an employee punches from (FR-ATT-11.1). At most one active row per user (partial unique
/// index in the M5 migration); a change goes through DeviceChangeRequest and keeps the old row inactive.
model DeviceBinding {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  deviceId    String
  platform    Platform
  model       String?
  isActive    Boolean   @default(true)
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, deviceId])
  @@index([workspaceId])
}

/// Employee asks to move their binding to a new phone (FR-ATT-11.2); approved through the approval
/// engine (subject DEVICE_CHANGE, FR-ATT-11.3).
model DeviceChangeRequest {
  id          String        @id @default(cuid())
  workspaceId String
  employeeId  String
  userId      String
  deviceId    String
  platform    Platform
  model       String?
  reason      String
  status      RequestStatus @default(PENDING)
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, employeeId])
}

/// Shared on-site tablet of a branch (FR-ATT-03, A2). Not an employee device binding: HR enrols it and
/// it authenticates with its own token (only the hash is stored).
model KioskDevice {
  id           String    @id @default(cuid())
  workspaceId  String
  branchId     String
  name         String
  tokenHash    String    @unique
  enrolledById String?
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([workspaceId, branchId])
}

// ───────────────────────── Organisation ─────────────────────────

model Branch {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  geofenceRadius  Int              @default(150)
  /// FR-WS-06: enabled attendance modes; several at once are allowed (06.4).
  attendanceModes AttendanceMode[] @default([MOBILE])
  /// FR-ATT-12 (SHOULD): office Wi-Fi networks (SSID names or BSSID MAC addresses). A mobile punch inside the
  /// geofence from a phone not on one of them is flagged WIFI_MISMATCH for review (never blocked). Empty = off.
  wifiNetworks    String[]         @default([])
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees Employee[]
  punches   AttendancePunch[]
  kiosks    KioskDevice[]

  @@unique([workspaceId, name])
}

model Department {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  parentId       String?
  headEmployeeId String?
  /// false = closed (FR-WS-02.2): hidden from pickers, kept for history.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  employees Employee[]

  @@unique([workspaceId, name])
}

model Position {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  level       Int      @default(0)
  /// false = closed (FR-WS-02.3): hidden from pickers, kept for history.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([workspaceId, name])
}

// ─────────────────────────── Employees ───────────────────────────

model Employee {
  id                   String           @id @default(cuid())
  workspaceId          String
  employeeCode         String
  firstName            String
  lastName             String
  /// English (Latin-script) name; firstName/lastName hold the Lao name (FR-EMP-01.1).
  firstNameEn          String?
  lastNameEn           String?
  nickname             String?
  gender               Gender
  dateOfBirth          DateTime?        @db.Date
  phone                String?
  email                String?
  /// Free-text street / house details; the structured Lao address follows (FR-EMP-01.4).
  address              String?
  /// ບ້ານ
  village              String?
  /// ເມືອງ
  district             String?
  /// ແຂວງ — a code from LAO_PROVINCES (packages/shared)
  province             String?
  nationalityType      NationalityType  @default(LAO)
  nationality          String?
  /// DEPRECATED plaintext — migrated to idCardNoEnc by scripts/backfill-pii.ts; drop in a later milestone.
  idCardNo             String?
  /// AES-256-GCM encrypted national ID card number
  idCardNoEnc          String?
  /// HMAC-SHA256 blind index for duplicate detection (FR-EMP-10.3)
  idCardNoHash         String?
  /// HMAC-SHA256 blind index for duplicate detection (FR-EMP-10.2)
  socialSecurityNoHash String?
  /// AES-256-GCM encrypted (see src/lib/crypto.ts)
  socialSecurityNoEnc  String?
  /// Date of social-security registration (FR-EMP-02.3)
  ssnRegisteredAt      DateTime?        @db.Date
  /// AES-256-GCM encrypted
  familyBookNoEnc      String?
  /// Household head named in the family book (FR-EMP-02.2)
  familyBookHolder     String?
  hireDate             DateTime         @db.Date
  /// FR-EMP-03.5/03.6 (split from the former EmploymentType)
  contractType         ContractType
  contractEndDate      DateTime?        @db.Date
  probationEndDate     DateTime?        @db.Date
  payType              PayType
  status               EmploymentStatus @default(PROBATION)
  hazardousWork        Boolean          @default(false)
  branchId             String?
  departmentId         String?
  positionId           String?
  managerId            String?
  workScheduleId       String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch            Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department        Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position          Position?              @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager           Employee?              @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports           Employee[]             @relation("ManagerReports")
  workSchedule      WorkSchedule?          @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  user              User?
  documents         EmployeeDocument[]
  emergencyContacts EmergencyContact[]
  history           EmploymentHistory[]
  punches           AttendancePunch[]
  attendanceDays    AttendanceDay[]
  corrections       AttendanceCorrection[]
  leaveLedger       LeaveLedgerEntry[]
  leaveRequests     LeaveRequest[]
  overtime          OvertimeRequest[]
  roster            ShiftRoster[]
  offsitePermits    OffsitePermission[]
  deviceRequests    DeviceChangeRequest[]
  onboardingTasks   OnboardingTask[]
  offboarding       Offboarding?
  scheduleHistory   ScheduleAssignment[]
  approvalRequests  ApprovalRequest[]

  @@unique([workspaceId, employeeCode])
  @@unique([workspaceId, idCardNoHash])
  @@unique([workspaceId, socialSecurityNoHash])
  @@index([workspaceId, status])
  @@index([workspaceId, managerId])
}

model EmployeeDocument {
  id            String       @id @default(cuid())
  workspaceId   String
  employeeId    String
  type          DocumentType
  number        String?
  issuedAt      DateTime?    @db.Date
  expiresAt     DateTime?    @db.Date
  fileUrl       String?
  fileId        String?
  note          String?
  /// Smallest alert threshold (90/60/30) already notified, to avoid duplicates.
  lastAlertDays Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  file     StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([workspaceId, expiresAt])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  workspaceId  String
  employeeId   String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model EmploymentHistory {
  id            String   @id @default(cuid())
  workspaceId   String
  employeeId    String
  changeType    String
  fromValue     Json?
  toValue       Json?
  effectiveDate DateTime @db.Date
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, employeeId])
}

// ─────────────────────── Time & attendance ───────────────────────

/// A working shift (FR-ATT-17). Times are local "HH:mm" in the workspace time zone; `endTime <= startTime`
/// means the shift crosses midnight (FR-ATT-17.2) and its work date is the day it starts.
model Shift {
  id                String   @id @default(cuid())
  workspaceId       String
  name              String
  /// Short label shown in the roster grid (e.g. "N").
  code              String?
  /// Roster colour "#RRGGBB".
  color             String?
  /// Local time "HH:mm"
  startTime         String
  endTime           String
  breakMinutes      Int      @default(60)
  /// Per-shift override; null = parameter `attendance.lateGraceMinutes` (FR-ATT-18.5).
  lateGraceMinutes  Int?
  /// Per-shift override; null = parameter `attendance.earlyGraceMinutes`.
  earlyGraceMinutes Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  schedules WorkSchedule[]
  roster    ShiftRoster[]

  @@unique([workspaceId, name])
}

/// Rotating roster (FR-ATT-17.3): the shift an employee works on one date, overriding the shift of their
/// work schedule. `shiftId = null` rosters a rest day.
model ShiftRoster {
  id          String   @id @default(cuid())
  workspaceId String
  employeeId  String
  date        DateTime @db.Date
  shiftId     String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([workspaceId, date])
}

/// A working-day pattern (FR-WS-03). Rows are never deleted, so the history stays readable:
/// - `isDefault = true`: one version of the workspace standard, in force from `effectiveFrom`
///   (the earliest version also covers earlier dates);
/// - `isDefault = false`: an individual (override) pattern, applied to employees through
///   ScheduleAssignment. Resolution rules: packages/shared/src/domain/work-schedule.ts.
model WorkSchedule {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  /// Scheduled minutes per weekday, index 0=Sun..6=Sat; 0 = rest day.
  dayMinutes    Int[]
  shiftId       String
  isDefault     Boolean   @default(false)
  /// Standard versions only: first day (workspace time zone) the version applies.
  effectiveFrom DateTime? @db.Date
  reason        String?
  createdById   String?
  createdAt     DateTime  @default(now())

  shift       Shift                @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  /// Legacy pointer (Employee.workScheduleId), superseded by ScheduleAssignment and backfilled in M3. Not read or written.
  employees   Employee[]
  assignments ScheduleAssignment[]

  @@unique([workspaceId, isDefault, effectiveFrom])
  @@index([workspaceId])
}

/// Effective-dated working schedule of one employee (FR-WS-03.2/03.4). The latest row with
/// `effectiveFrom <= date` applies; `scheduleId = null` means "back to the workspace standard".
/// Employees without any row work the standard.
model ScheduleAssignment {
  id            String   @id @default(cuid())
  workspaceId   String
  employeeId    String
  /// Override pattern (WorkSchedule with isDefault = false); null = workspace standard.
  scheduleId    String?
  effectiveFrom DateTime @db.Date
  reason        String?
  createdById   String?
  createdAt     DateTime @default(now())

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule WorkSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([workspaceId, employeeId])
}

enum HolidayKind {
  PUBLIC
  TRADITIONAL
  SUBSTITUTE
  NATIONAL_DAY
}

/// Workspace holiday calendar (FR-WS-04/05). One entry per date; apply it per employee with `holidaysFor()` (@hrm/shared).
model Holiday {
  id          String      @id @default(cuid())
  workspaceId String
  date        DateTime    @db.Date
  nameLo      String
  nameEn      String
  kind        HolidayKind @default(PUBLIC)
  /// Only female employees get the day off (8 March).
  womenOnly   Boolean     @default(false)
  /// When set, only employees of this nationality get the day (foreign national day, FR-WS-05).
  nationality String?
  /// Created from the statutory defaults (`ensureYear`); a year with any default row counts as seeded.
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@unique([workspaceId, date])
}

/// One raw punch (A13): every check-in/out from any source, kept as recorded. Corrections never edit a
/// punch — they add a CORRECTION punch and point the original at it (`supersededById`, FR-ATT-19.3).
/// A punch counts for the day unless superseded or its review was REJECTED (see `punchCounts`, @hrm/shared).
model AttendancePunch {
  id                String            @id @default(cuid())
  workspaceId       String
  employeeId        String
  branchId          String?
  kind              PunchKind
  /// Work date (workspace time zone) the punch belongs to; a night shift's punches belong to its start day.
  workDate          DateTime          @db.Date
  /// Instant of the punch: the device clock for MOBILE/KIOSK (offline capture), the file time for SCANNER.
  capturedAt        DateTime
  /// Server time the punch arrived (FR-ATT-06.2, FR-ATT-07.1).
  receivedAt        DateTime          @default(now())
  latitude          Float?
  longitude         Float?
  accuracyMetres    Float?
  /// Distance from the branch geofence centre at capture (FR-ATT-15.2).
  distanceMetres    Float?
  source            AttendanceSource
  /// Idempotency key generated on the device for offline queue replay (FR-ATT-05.2).
  clientRef         String?
  deviceId          String?
  kioskDeviceId     String?
  selfieFileId      String?
  /// Captured while the device was offline and synced later (FR-ATT-06.1).
  offline           Boolean           @default(false)
  /// Out-of-zone punch under an off-site permission (FR-ATT-16.2); needs manager approval (16.3).
  offsite           Boolean           @default(false)
  offsiteReason     String?
  suspicious        Boolean           @default(false)
  /// e.g. DEVICE_TIME_SKEW, ROOTED (see SuspicionReason in @hrm/shared).
  suspiciousReasons String[]          @default([])
  reviewStatus      PunchReviewStatus @default(NONE)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  /// HR on behalf (FR-ATT-04): who recorded it and why.
  createdById       String?
  reason            String?
  scanImportId      String?
  /// Set when a correction replaced this punch (FR-ATT-19.3); the replacement punch's id, or null when the
  /// correction removed it (then `supersededAt` alone is set).
  supersededById    String?
  supersededAt      DateTime?
  createdAt         DateTime          @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, clientRef])
  @@index([workspaceId, employeeId, workDate])
  @@index([workspaceId, workDate])
  @@index([workspaceId, reviewStatus])
}

/// Computed result of one employee's work date (A13, FR-ATT-18). Rebuilt from punches, schedule, roster,
/// holidays and approved leave by the attendance calculation; never edited by hand.
model AttendanceDay {
  id                String           @id @default(cuid())
  workspaceId       String
  employeeId        String
  workDate          DateTime         @db.Date
  /// Shift worked that day (roster or schedule); null on rest days/holidays without a shift.
  shiftId           String?
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  scheduledMinutes  Int              @default(0)
  firstInPunchId    String?
  lastOutPunchId    String?
  firstInAt         DateTime?
  lastOutAt         DateTime?
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  workedMinutes     Int              @default(0)
  status            AttendanceStatus
  /// Set once the missing-punch alert went out, so the job notifies once (FR-NOTI-03.3).
  missingNotifiedAt DateTime?
  computedAt        DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// One row per employee and work date: a roster gives at most one shift a day, and a night shift
  /// belongs to the day it starts.
  @@unique([employeeId, workDate])
  @@index([workspaceId, workDate])
  @@index([workspaceId, status])
}

/// HR-granted permission to check in outside the branch zone (FR-ATT-16.1), for a date range.
model OffsitePermission {
  id          String    @id @default(cuid())
  workspaceId String
  employeeId  String
  fromDate    DateTime  @db.Date
  toDate      DateTime  @db.Date
  note        String?
  grantedById String?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, employeeId])
}

/// Time-correction request (FR-ATT-19), decided through the approval engine (ATTENDANCE_CORRECTION).
/// Approval adds CORRECTION punches and supersedes the originals, keeping both (19.3).
model AttendanceCorrection {
  id                 String        @id @default(cuid())
  workspaceId        String
  employeeId         String
  workDate           DateTime      @db.Date
  /// Punches being replaced (null = the punch was missing).
  originalInPunchId  String?
  originalOutPunchId String?
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String
  attachmentFileId   String?
  status             RequestStatus @default(PENDING)
  decidedAt          DateTime?
  createdById        String?
  createdAt          DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, employeeId, workDate])
}

/// OT request (FR-ATT-20), decided through the approval engine (OVERTIME). Minutes are split into the four
/// payroll categories by the backend (FR-ATT-21) from the actual times (POST) or the planned ones (PRE).
model OvertimeRequest {
  id                  String        @id @default(cuid())
  workspaceId         String
  employeeId          String
  workDate            DateTime      @db.Date
  kind                OvertimeKind
  plannedStart        DateTime
  plannedEnd          DateTime
  actualStart         DateTime?
  actualEnd           DateTime?
  reason              String
  minutes             Int
  workdayDayMinutes   Int           @default(0)
  workdayNightMinutes Int           @default(0)
  holidayDayMinutes   Int           @default(0)
  holidayNightMinutes Int           @default(0)
  status              RequestStatus @default(PENDING)
  decidedAt           DateTime?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, employeeId, workDate])
  @@index([workspaceId, status])
}

/// A confirmed scanner-file import (FR-ATT-02). Preview is rolled back; only confirmed files are stored.
model ScanImport {
  id           String           @id @default(cuid())
  workspaceId  String
  fileName     String
  format       ScanFormat
  /// sha256 of the uploaded bytes; the confirm token is bound to it (FR-ATT-02.6).
  sha256       String
  branchId     String?
  status       ScanImportStatus @default(PENDING)
  uploadedById String?
  totalRows    Int              @default(0)
  importedRows Int              @default(0)
  errorRows    Int              @default(0)
  createdAt    DateTime         @default(now())

  rows ScanImportRow[]

  @@index([workspaceId, createdAt])
}

model ScanImportRow {
  id                 String        @id @default(cuid())
  workspaceId        String
  importId           String
  rowNumber          Int
  employeeCode       String?
  capturedAt         DateTime?
  matchedEmployeeId  String?
  status             ScanRowStatus
  /// Existing punch (or earlier row's punch) this row repeats (FR-ATT-02.5).
  duplicateOfPunchId String?
  punchId            String?
  error              String?

  import ScanImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([workspaceId, importId])
}

// ───────────────────────────── Leave ─────────────────────────────
// M6 (A14): balances are a ledger. Every movement (grant, use, cancel, HR adjust, carry-over, expiry) is a
// LeaveLedgerEntry and a balance is the sum of the entries of one employee / type / leave year (calendar year,
// client 2026-11-18 Q10). Statutory legal minima live in @hrm/shared (LEAVE_LEGAL_MINIMUM), not here.

/// How the days of a request are counted (FR-LV-04).
enum LeaveCountingMethod {
  /// Only the employee's own working days (schedule/roster, minus their holidays) count (FR-LV-03.3, 04.2).
  WORKING_DAYS
  /// Every calendar day counts (maternity, FR-LV-04.1).
  CALENDAR_DAYS
}

/// What `LeavePolicy.daysPerYear` limits.
enum LeaveQuotaPeriod {
  /// A balance per calendar year, granted by the accrual job (annual, sick).
  YEARLY
  /// Each request may take at most the quota; no yearly balance (personal/marriage/bereavement, maternity — Q11).
  PER_EVENT
  /// No quota (unpaid leave).
  UNLIMITED
}

enum LeaveLedgerKind {
  ENTITLEMENT
  USAGE
  CANCEL
  ADJUST
  CARRY
  EXPIRE
}

/// In what capacity a leave request was filed (FR-LV-10).
enum LeaveFiledAs {
  SELF
  /// HR on behalf of an employee (permission `leave.file_on_behalf`).
  HR
  /// A manager on behalf of someone in their reporting line.
  MANAGER
}

model LeaveType {
  id                 String              @id @default(cuid())
  workspaceId        String
  code               String
  category           LeaveCategory
  nameLo             String
  nameEn             String
  paid               Boolean             @default(true)
  /// A medical certificate is needed above `leave.certificateThresholdDays` (FR-LV-05).
  requiresAttachment Boolean             @default(false)
  allowHalfDay       Boolean             @default(true)
  gender             Gender?
  isActive           Boolean             @default(true)
  countingMethod     LeaveCountingMethod @default(WORKING_DAYS)
  quotaPeriod        LeaveQuotaPeriod    @default(YEARLY)
  /// Created by HR (FR-LV-02); statutory types are seeded and can only be edited.
  isCustom           Boolean             @default(false)
  sortOrder          Int                 @default(0)

  policy   LeavePolicy?
  ledger   LeaveLedgerEntry[]
  requests LeaveRequest[]

  @@unique([workspaceId, code])
}

model LeavePolicy {
  id                 String    @id @default(cuid())
  workspaceId        String
  leaveTypeId        String    @unique
  /// Days per leave year (YEARLY) or per request (PER_EVENT); unused for UNLIMITED. HR edits it (FR-LV-01.1).
  daysPerYear        Decimal   @db.Decimal(6, 2)
  /// Days for employees doing hazardous work (annual leave 18).
  hazardousDays      Decimal?  @db.Decimal(6, 2)
  /// Days for a multiple birth (maternity 120).
  multipleBirthDays  Decimal?  @db.Decimal(6, 2)
  /// Service days needed before the type may be used and before it is granted (annual 365 — Q10).
  minServiceDays     Int       @default(0)
  /// Pay types `minServiceDays` applies to; empty = every pay type (sick leave: DAILY/HOURLY only — Q15).
  minServicePayTypes PayType[] @default([])

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// One balance movement (FR-LV-07). `days` is signed: grants/carry/cancel are positive, usage/expiry negative,
/// adjustments either. Rows are never edited; corrections are new ADJUST rows.
model LeaveLedgerEntry {
  id             String          @id @default(cuid())
  workspaceId    String
  employeeId     String
  leaveTypeId    String
  /// Leave year (calendar year) the movement belongs to.
  periodYear     Int
  kind           LeaveLedgerKind
  days           Decimal         @db.Decimal(6, 2)
  effectiveDate  DateTime        @db.Date
  leaveRequestId String?
  reason         String?
  /// Null for the system (accrual / carry-over jobs).
  createdById    String?
  createdAt      DateTime        @default(now())

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@index([workspaceId, employeeId, leaveTypeId, periodYear])
  @@index([leaveRequestId])
}

model LeaveRequest {
  id                 String        @id @default(cuid())
  workspaceId        String
  employeeId         String
  leaveTypeId        String
  startDate          DateTime      @db.Date
  endDate            DateTime      @db.Date
  /// Half day (FR-LV-03.2); only on a single-day request.
  halfDay            HalfDay       @default(NONE)
  /// Maternity: multiple birth (longer quota).
  multipleBirth      Boolean       @default(false)
  /// Computed by the API only (FR-LV-03.3/04); never sent by clients.
  days               Decimal       @db.Decimal(6, 2)
  reason             String?
  /// Medical certificate (FR-LV-05); may be attached until `certificateDueDate`.
  certificateFileId  String?
  certificateDueDate DateTime?     @db.Date
  /// Mirrors the decision of its ApprovalRequest (subjectType LEAVE); CANCELLED once withdrawn or cancelled.
  status             RequestStatus @default(PENDING)
  /// Who filed it: the employee, or HR / a manager on their behalf (FR-LV-10).
  submittedByUserId  String?
  filedAs            LeaveFiledAs  @default(SELF)
  /// Delegation created for a manager's absence (FR-ORG-03.2); cancelled with the leave.
  delegationId       String?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType            @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  certificateFile StoredFile?          @relation(fields: [certificateFileId], references: [id], onDelete: SetNull)
  ledger          LeaveLedgerEntry[]
  cancelRequests  LeaveCancelRequest[]

  @@index([workspaceId, status])
  @@index([workspaceId, employeeId])
  @@index([workspaceId, startDate, endDate])
}

/// Request to cancel an APPROVED leave (FR-LV-12.2), decided through the approval engine (subject LEAVE_CANCEL).
/// At most one PENDING per leave request (partial unique index in the migration).
model LeaveCancelRequest {
  id                String        @id @default(cuid())
  workspaceId       String
  leaveRequestId    String
  reason            String
  status            RequestStatus @default(PENDING)
  requestedByUserId String?
  decidedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leaveRequestId])
}

// ─────────────────────────── Approvals ───────────────────────────
// Generic approval engine (FR-ORG-02..06, src/modules/approvals). Replaces the schema-only
// LeaveApproval / LeaveRequest.currentStep: every subject (leave, overtime, attendance correction)
// shares one request + step history, and its module reacts through a handler.

enum ApprovalSubjectType {
  LEAVE
  OVERTIME
  ATTENDANCE_CORRECTION
  /// Out-of-zone check-in under an off-site permission (FR-ATT-16.3); subject = AttendancePunch.
  OFFSITE_CHECKIN
  /// Move the device binding to a new phone (FR-ATT-11.3); subject = DeviceChangeRequest.
  DEVICE_CHANGE
  /// Cancellation of an approved leave (FR-LV-12.2); subject = LeaveCancelRequest.
  LEAVE_CANCEL
}

/// FR-ORG-06 — capacity in which a step is decided.
enum ApprovalCapacity {
  MANAGER
  DELEGATE
  UPPER_LEVEL
  HR
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

/// One request for approval of a subject row (e.g. a LeaveRequest), routed along the requester's
/// chain of command. Exactly one step is PENDING while the request is PENDING.
model ApprovalRequest {
  id                  String              @id @default(cuid())
  workspaceId         String
  subjectType         ApprovalSubjectType
  /// Id of the subject row in its own table.
  subjectId           String
  requesterEmployeeId String
  status              RequestStatus       @default(PENDING)
  /// Level currently waiting for a decision (1 = direct manager).
  currentStep         Int                 @default(1)
  /// Workspace parameter `approval.levels` when the request was submitted.
  requiredLevels      Int                 @default(1)
  submittedByUserId   String?
  decidedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  requester Employee       @relation(fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  steps     ApprovalStep[]

  @@unique([workspaceId, subjectType, subjectId])
  @@index([workspaceId, status])
  @@index([workspaceId, requesterEmployeeId])
}

/// One routing of a request level to an approver (FR-ORG-06 history). An escalated step stays as
/// ESCALATED and a new step for the same level follows it.
model ApprovalStep {
  id              String           @id @default(cuid())
  workspaceId     String
  requestId       String
  level           Int
  /// Position of the approver in the requester's chain (0 = direct manager); null = HR fallback.
  chainIndex      Int?
  /// Manager owning the step; null = HR fallback (any user holding `approval.hr_fallback`).
  approverUserId  String?
  /// The manager's active delegate when the step was routed (FR-ORG-03).
  delegateUserId  String?
  /// Routed capacity while pending; the capacity actually used once decided.
  actingAs        ApprovalCapacity
  decision        ApprovalDecision @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  note            String?
  createdAt       DateTime         @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([workspaceId, decision, approverUserId])
  @@index([workspaceId, decision, delegateUserId])
}

/// A manager lets another user approve on their behalf for a date range (FR-ORG-03).
/// `isActive = false` means cancelled; rows are kept for the audit trail.
model ApprovalDelegation {
  id              String   @id @default(cuid())
  workspaceId     String
  delegatorUserId String
  delegateUserId  String
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  reason          String?
  isActive        Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([workspaceId, delegatorUserId])
  @@index([workspaceId, delegateUserId])
}

// ───────────────────── Onboarding / offboarding ─────────────────────

model OnboardingTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  kind        TaskKind
  createdAt   DateTime @default(now())

  tasks OnboardingTemplateTask[]

  @@unique([workspaceId, name])
}

model OnboardingTemplateTask {
  id            String @id @default(cuid())
  workspaceId   String
  templateId    String
  title         String
  dueOffsetDays Int    @default(0)
  sortOrder     Int    @default(0)

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model OnboardingTask {
  id            String    @id @default(cuid())
  workspaceId   String
  employeeId    String
  kind          TaskKind
  title         String
  dueDate       DateTime? @db.Date
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, employeeId])
}

/// Exit record. Leave & OT balances are frozen here for the payroll module.
model Offboarding {
  id                 String    @id @default(cuid())
  workspaceId        String
  employeeId         String    @unique
  lastWorkingDate    DateTime  @db.Date
  reason             String?
  leaveBalanceAtExit Json?
  otMinutesAtExit    Int       @default(0)
  accessRevokedAt    DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?
  /// In-app route to open (e.g. /employees/abc), FR-NOTI-04.2
  link        String?
  /// Prevents duplicate notifications for the same event (FR-NOTI-04.4)
  dedupeKey   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([workspaceId, userId, dedupeKey])
  @@index([workspaceId, userId, readAt])
}

/// Outbound delivery attempts per channel (push/SMS); retried by the job worker (FR-NOTI-04.5).
model NotificationDelivery {
  id                String              @id @default(cuid())
  workspaceId       String
  notificationId    String
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  lastError         String?
  sentAt            DateTime?
  /// SMS text rendered in the recipient's language when queued (FR-NOTI-02.3); null for push.
  message           String?
  /// Expo push tickets of the last send, `[{ id, token }]`, checked for receipts later (FR-NOTI-01.1).
  pushTickets       Json?
  /// When the push receipts of `pushTickets` were processed; null = still to check.
  receiptsCheckedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([workspaceId, status])
}

// ─────────────────────── Files & OTP ───────────────────────

/// Uploaded file metadata; bytes live in the storage adapter under `{workspaceId}/{purpose}/{id}`.
model StoredFile {
  id           String      @id @default(cuid())
  workspaceId  String
  storageKey   String      @unique
  purpose      FilePurpose
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedById String?
  createdAt    DateTime    @default(now())

  employeeDocuments EmployeeDocument[]
  leaveCertificates LeaveRequest[]

  @@index([workspaceId, purpose])
}

/// SMS one-time passwords (FR-AUTH-02). Only the hash of the code is stored.
model OtpChallenge {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  purpose     OtpPurpose
  phone       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([workspaceId, userId, purpose, createdAt])
}

// ─────────────────────── Configurable parameters ───────────────────────

/// Workspace business parameters with effective dates (FR-WS-08). Keys/limits: packages/shared/src/domain/parameters.ts
model WorkspaceParameter {
  id            String   @id @default(cuid())
  workspaceId   String
  key           String
  value         Json
  effectiveFrom DateTime @db.Date
  createdById   String?
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([workspaceId, key, effectiveFrom])
  @@index([workspaceId, key])
}

// ─────────────────────── SOM platform (not tenant scoped) ───────────────────────

/// System-level parameters editable only by SOM super admins (FR-WS-08.7).
model SystemParameter {
  id            String   @id @default(cuid())
  key           String
  value         Json
  effectiveFrom DateTime
  createdById   String?
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([key, effectiveFrom])
}

/// SOM Development staff who operate the platform (FR-WS-01.1).
model PlatformUser {
  id             String    @id @default(cuid())
  email          String    @unique
  displayName    String
  passwordHash   String
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens PlatformRefreshToken[]
}

model PlatformRefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

/// Append-only audit trail for platform-level actions.
model PlatformAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PushToken {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  token       String   @unique
  platform    Platform
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
