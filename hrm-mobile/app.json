{
  "expo": {
    "name": "Tech Solutions HRM",
    "slug": "som-hrm",
    "scheme": "somhrm",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "la.som.hrm",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tech Solutions HRM ໃຊ້ຕຳແໜ່ງເພື່ອກວດສອບການລົງເວລາຢູ່ສາຂາ / Location is used to verify check-in at your branch.",
        "NSCameraUsageDescription": "Tech Solutions HRM ໃຊ້ກ້ອງຖ່າຍ selfie ຕອນລົງເວລາ / The camera is used for check-in selfies.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "la.som.hrm",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo-mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tech Solutions HRM ໃຊ້ຕຳແໜ່ງເພື່ອກວດສອບການລົງເວລາຢູ່ສາຂາ / Location is used to verify check-in at your branch."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tech Solutions HRM ໃຊ້ກ້ອງຖ່າຍ selfie ຕອນລົງເວລາ / The camera is used for check-in selfies.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
