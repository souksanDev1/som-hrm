{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hrm-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hrm/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "hrm-api-mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hrm/api",
        "exec",
        "tsx",
        "--env-file=/Users/csl-pc033/Desktop/HRM/hrm-api/.env",
        "/Users/csl-pc033/Desktop/HRM/hrm-api/src/server.ts"
      ],
      "env": {
        "DATABASE_URL": "postgresql://hrm:hrm@localhost:5432/hrm_mobile_m4?schema=public"
      },
      "port": 4000
    },
    {
      "name": "hrm-api-mobile-m5",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hrm/api",
        "exec",
        "tsx",
        "--env-file=/Users/csl-pc033/Desktop/HRM/hrm-api/.env",
        "/Users/csl-pc033/Desktop/HRM/hrm-api/src/server.ts"
      ],
      "env": {
        "DATABASE_URL": "postgresql://hrm:hrm@localhost:5432/hrm_mobile_m5?schema=public",
        "PORT": "4001"
      },
      "port": 4001
    },
    {
      "name": "hrm-mobile-metro-m5",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@hrm/mobile", "exec", "expo", "start", "--dev-client", "--port", "8082"],
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4001/api/v1",
        "EXPO_PUBLIC_ALLOW_MOCK_LOCATION": "true",
        "CI": "1"
      },
      "port": 8082
    }
  ]
}
